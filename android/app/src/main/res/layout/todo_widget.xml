<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    style="@style/Widget.Android.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:theme="@style/Theme.Android.AppWidgetContainer">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:ellipsize="end"
        android:focusable="true"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_title"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/widget_empty"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="18sp"
        android:visibility="gone"
        tools:text="No todos yet"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/todo_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/widget_todo_row_height"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/todo_check_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:contentDescription="@string/widget_complete_todo"
            android:focusable="true"
            android:minWidth="32dp"
            android:minHeight="32dp" />

        <TextView
            android:id="@+id/todo_title_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="18sp"
            tools:text="Write unit tests" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
